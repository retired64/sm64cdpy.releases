{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sm64cdpy.org/schemas/release-manifest-v1.schema.json",
  "title": "SM64CDPY release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "version",
    "build",
    "publishedAt",
    "forceUpdate",
    "locales"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "build": { "type": "integer", "minimum": 1 },
    "publishedAt": { "type": "string", "format": "date-time" },
    "forceUpdate": { "type": "boolean" },
    "locales": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en", "es", "pt-BR"],
      "properties": {
        "en": { "$ref": "#/$defs/localizedRelease" },
        "es": { "$ref": "#/$defs/localizedRelease" },
        "pt-BR": { "$ref": "#/$defs/localizedRelease" }
      }
    }
  },
  "$defs": {
    "nonEmptyText": { "type": "string", "minLength": 1 },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["heading", "items"],
      "properties": {
        "heading": { "$ref": "#/$defs/nonEmptyText" },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/nonEmptyText" }
        }
      }
    },
    "localizedRelease": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "summary", "highlights", "sections"],
      "properties": {
        "title": { "$ref": "#/$defs/nonEmptyText" },
        "summary": { "$ref": "#/$defs/nonEmptyText" },
        "highlights": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/nonEmptyText" }
        },
        "sections": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/section" }
        }
      }
    }
  }
}
