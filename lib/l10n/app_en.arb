    "description": "Disclaimer screen section header for personal purpose"
  },
  "disclaimerBodyPersonalPurpose": "SM64CDPY is an independent Android catalog and manager for community-created SM64CoopDX mods. It helps users browse, download, organize, and install compatible content in folders selected by the user. The app does not distribute or install Super Mario 64, ROM files, SM64CoopDX, or Android builds of SM64CoopDX. It does not request, verify, or provide instructions for obtaining any game file.",
  "@disclaimerBodyPersonalPurpose": {
    "description": "Disclaimer screen body text for the personal purpose section"
  },
  "disclaimerSectionNoAffiliation": "No official affiliation",
  "@disclaimerSectionNoAffiliation": {
    "description": "Disclaimer screen section header for no official affiliation"
  },
  "disclaimerBodyNoAffiliation": "This project is not associated with, endorsed by, or approved by Nintendo, the SM64CoopDX team, or the listed mod authors. Product names and trademarks identify compatibility only. Mod titles, descriptions, images, files, and other credited material remain the property of their respective authors or rights holders.",
  "@disclaimerBodyNoAffiliation": {
    "description": "Disclaimer screen body text for the no affiliation section"
  },
  "disclaimerSectionDataSource": "Data source",
  "@disclaimerSectionDataSource": {
    "description": "Disclaimer screen section header for data source"
  },
  "disclaimerBodyDataSource": "The main catalog presents public community listings from Coop DX Mods (mods.sm64coopdx.com) while preserving the published author, title, dates, versions, and source. SM64CDPY provides a mobile interface and retrieves downloads from the source made available for each resource; catalog inclusion does not imply ownership or official endorsement by SM64CDPY.",
  "@disclaimerBodyDataSource": {
    "description": "Disclaimer screen body text for the data source section"
  },
  "disclaimerSectionExclusive": "Curated sections (VIP · DynOS · Touch Controls)",
  "@disclaimerSectionExclusive": {
    "description": "Disclaimer screen section header for exclusive sections"
  },
  "disclaimerBodyExclusive": "In v{version}, VIP Mods, DynOS packs, Touch Control layouts, OMM Rebirth, and Render96 may use independently curated sources. Whenever content was not created by the SM64CDPY developer, its credited creator retains authorship. These sections are separate from the main Coop DX Mods catalog and are not official Nintendo or SM64CoopDX services.",
  "@disclaimerBodyExclusive": {
    "description": "Disclaimer screen body text for the exclusive sections"
  },
  "disclaimerSectionLocalData": "Accounts and local data",
  "@disclaimerSectionLocalData": {
    "description": "Disclaimer section header for accounts and locally stored app data"
  },
  "disclaimerBodyLocalData": "SM64CDPY currently does not create user accounts. Favorites, installation history, selected folders, and app preferences are stored locally on the device. Removing the app or clearing its data may remove this information.",
  "@disclaimerBodyLocalData": {
    "description": "Disclaimer body explaining the current absence of accounts and local storage"
  },
  "disclaimerSectionExternalServices": "External services",
  "@disclaimerSectionExternalServices": {
    "description": "Disclaimer section header for third-party network services"
  },
  "disclaimerBodyExternalServices": "Browsing, refreshing catalogs, opening links, and downloading content may connect to services such as Coop DX Mods, GitHub, Google Drive, Dropbox, or GameBanana. Those services operate under their own terms and privacy practices, which SM64CDPY does not control.",
  "@disclaimerBodyExternalServices": {
    "description": "Disclaimer body describing external content and download services"
  },
  "disclaimerSectionBugs": "Support and content corrections",
  "@disclaimerSectionBugs": {
    "description": "Disclaimer screen section header for bugs and suggestions"
  },
  "disclaimerBodyBugs": "Contact the SM64CDPY developer if you find an app issue, incorrect attribution, outdated information, or content that should be corrected or removed. Please include the mod title and source when applicable. App-related requests should not be directed to Nintendo, the SM64CoopDX team, or mod authors.",
  "@disclaimerBodyBugs": {
    "description": "Disclaimer screen body text for the bugs and suggestions section"
  },

